# ====================================================================
# Telegram Productivity Coach - Environment Configuration (.env.example)
# Copy this file to .env and replace the placeholders with your values.
# Do NOT commit your real .env file with secrets into version control.
# ====================================================================

# REQUIRED: Telegram Bot API Token obtained from @BotFather on Telegram.
# Format: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# REQUIRED: MongoDB Atlas connection string (or local MongoDB replica set).
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# OPTIONAL: Name of the MongoDB database to use. Defaults to 'ttaskam' if omitted.
MONGO_DB_NAME=ttaskam

# ====================================================================
# AI Productivity Coach (LLM Provider Configuration)
# If omitted or empty, the bot runs in 100% deterministic manual mode.
# ====================================================================

# OPTIONAL: API key for the LLM provider (e.g. OpenAI or Gemini or Groq).
LLM_API_KEY=your_llm_api_key_here

# OPTIONAL: REST Base URL. Defaults to 'https://api.openai.com/v1' if omitted.
LLM_BASE_URL=https://api.openai.com/v1

# OPTIONAL: Model name. Defaults to 'gpt-4o-mini' if omitted.
LLM_MODEL=gpt-4o-mini

# ====================================================================
# AvalAI Model Discovery & Comparison Tool (cmd/avalai-check)
# ====================================================================

# REQUIRED FOR AVALAI-CHECK: API key from https://avalai.ir
# Format: aa-...
AVALAI_API_KEY=your_avalai_api_key_here

# OPTIONAL: AvalAI base URL. Defaults to 'https://api.avalai.ir/v1' if omitted.
AVALAI_BASE_URL=https://api.avalai.ir/v1
